{
  "name": "Parcel",
  "type": "object",
  "properties": {
    "owner_name": {
      "type": "string",
      "description": "Full name of the land owner"
    },
    "phone": {
      "type": "string",
      "description": "Phone number of the owner"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude"
    },
    "description": {
      "type": "string",
      "description": "Description of the land parcel"
    },
    "photos": {
      "type": "array",
      "description": "URLs of uploaded photos",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected",
        "under_review"
      ],
      "default": "pending",
      "description": "Verification status"
    },
    "confidence_score": {
      "type": "number",
      "description": "Verification confidence score 0-100"
    },
    "verification_notes": {
      "type": "string",
      "description": "Notes from verifier"
    },
    "flags": {
      "type": "array",
      "description": "Fraud detection flags",
      "items": {
        "type": "string"
      }
    },
    "captured_at": {
      "type": "string",
      "description": "ISO timestamp of field capture"
    },
    "land_id": {
      "type": "string",
      "description": "Auto-generated unique land ID assigned on verification"
    },
    "plot_type": {
      "type": "string",
      "enum": [
        "full",
        "half"
      ],
      "description": "Type of plot"
    },
    "ownership_type": {
      "type": "string",
      "enum": [
        "family_owned",
        "purchased"
      ],
      "description": "How ownership was acquired"
    },
    "family_history": {
      "type": "string",
      "description": "Family land history notes"
    },
    "purchased_from": {
      "type": "string",
      "description": "Name of person/entity land was purchased from"
    }
  },
  "required": [
    "owner_name",
    "phone"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "surveyor"
          }
        },
        {
          "user_condition": {
            "role": "government"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "surveyor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}