      "type": [
        "string",
        "null"
      ]
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_type": {
      "const": "LandVault",
      "type": "string"
    },
    "aggregate_version": {
      "minimum": 0,
      "type": "integer"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_id": {
      "pattern": "^evt_[a-f0-9]{32}$",
      "type": "string"
    },
    "event_type": {
      "const": "registry.landvault.updated",
      "type": "string"
    },
    "event_version": {
      "const": 1,
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "description": "string — principal id who performed the update",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "boundary_source": {
          "description": "string|null — present for geometry updates",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "changes": {
          "description": "object|array — keys/values that changed (omitted for sensitive facets)",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "facet": {
          "description": "string — 'location' | 'geometry' | 'ownership_contact' | 'ownership_transfer' | 'survey' | 'community_data'",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "reason": {
          "description": "string|null — present for ownership_transfer",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
