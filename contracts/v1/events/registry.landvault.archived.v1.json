{
  "$id": "https://aquasavannah.landvault/contracts/v1/events/registry.landvault.archived.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Domain event emitted by the `registry` bounded context for aggregate `LandVault`. Schema validates the full envelope; `payload` carries the aggregate-specific fields documented under `x-payload-fields`.",
  "properties": {
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "aggregate_id": {
      "type": "string"
    },
    "aggregate_type": {
      "const": "LandVault",
      "type": "string"
    },
    "aggregate_version": {
      "minimum": 0,
      "type": "integer"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_id": {
      "pattern": "^evt_[a-f0-9]{32}$",
      "type": "string"
    },
    "event_type": {
      "const": "registry.landvault.archived",
      "type": "string"
    },
    "event_version": {
      "const": 1,
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "organization_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "additionalProperties": true,
      "properties": {
        "actor": {
          "description": "string — super_admin principal id",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "archived_at": {
          "description": "string — ISO8601 timestamp",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "reason": {
          "description": "string — operator-supplied reason",
          "type": [
            "string",
            "number",
            "boolean",
            "object",
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "producer": {
      "const": "registry",
      "type": "string"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "producer",
    "payload"
  ],
  "title": "registry.landvault.archived",
  "type": "object",
  "x-aggregate": "LandVault",
  "x-bounded-context": "registry",
  "x-contract-version": "1.3.0",
  "x-event-name": "registry.landvault.archived",
  "x-event-version": 1,
  "x-idempotency": "Dedup by `event_id`.",
  "x-known-consumers": [
    "audit-log",
    "metrics",
    "search-index",
    "evidence"
  ],
  "x-ordering": "Per-LandVault ordering by `aggregate_version`. Always the terminal event for an aggregate.",
  "x-payload-fields": {
    "actor": "string — super_admin principal id",
    "archived_at": "string — ISO8601 timestamp",
    "reason": "string — operator-supplied reason"
  },
  "x-producer": "registry",
  "x-replay": "Idempotent. Archive is one-way."
}
