        "super_admin",
        "surveyor_general",
        "compliance_officer",
        "government_observer"
      ]
    },
    {
      "action": "registry.landvault.update.survey",
      "description": "Update survey facet.",
      "required_roles": [
        "super_admin",
        "surveyor_general",
        "surveyor",
        "licensed_surveyor",
        "surveyor_partner",
        "field_agent"
      ]
    },
    {
      "action": "registry.landvault.update.community_data",
      "description": "Update community/consent facet.",
      "required_roles": [
        "super_admin",
        "surveyor_general",
        "compliance_officer",
        "community_validator"
